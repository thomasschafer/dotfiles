#!/usr/bin/env bash
# Sets up the credentials the job needs if they're missing: a Claude CLI login, and the
# GitHub and Todoist tokens in the keychain (macOS) or secret-tool (Linux). Prompts only
# when run interactively; otherwise warns about anything missing. Safe to re-run.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$script_dir/lib.sh"

# The path the scheduled job uses; it may not be on PATH yet during a fresh setup.
CLAUDE_BIN="$HOME/.local/bin/claude"

secret_exists() {
    if is_macos; then
        security find-generic-password -s "$1" >/dev/null 2>&1
    else
        secret-tool lookup service "$1" >/dev/null 2>&1
    fi
}

# Prompts for the secret itself, so it never appears in argv or shell history.
store_secret() {
    if is_macos; then
        security add-generic-password -s "$1" -a "$USER" -w
    else
        secret-tool store --label="$1" service "$1"
    fi
}

claude_logged_in() {
    "$CLAUDE_BIN" auth status --json 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1
}

# Usage: offer <what's missing> <instructions> <command...>
# Explains what's missing and runs <command> if the user agrees. Warns instead when
# there's no terminal to prompt in.
offer() {
    local missing="$1" instructions="$2" answer
    shift 2
    if [ ! -t 0 ]; then
        echo "Warning: dependabot-review: $missing; run $script_dir/setup-secrets to set it up" >&2
        return
    fi
    echo
    echo "dependabot-review: $missing."
    [ -n "$instructions" ] && echo "$instructions"
    read -rp "Set it up now? [y/N] " answer
    if [ "$answer" = y ] || [ "$answer" = Y ]; then
        "$@"
    else
        echo "Skipped. Run $script_dir/setup-secrets later; the job fails until it's set up." >&2
    fi
}

# Usage: ensure_secret <service> <how to create it>
ensure_secret() {
    secret_exists "$1" || offer "$1 is missing" "$2" store_secret "$1"
}

require_commands jq
is_macos || require_commands secret-tool

if [ ! -x "$CLAUDE_BIN" ]; then
    echo "Warning: dependabot-review: $CLAUDE_BIN not found; install the Claude CLI, then run $script_dir/setup-secrets" >&2
elif ! claude_logged_in; then
    offer "the Claude CLI isn't logged in" "" "$CLAUDE_BIN" auth login
fi

ensure_secret "$GITHUB_TOKEN_SECRET" "Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
  Resource owner: your account. Repository access: all repositories.
  Permissions: Contents and Pull requests read/write; Checks, Actions and Commit statuses read.
  Don't grant Administration or Workflows."

ensure_secret "$TODOIST_TOKEN_SECRET" "Copy your API token from Todoist: Settings, Integrations, Developer."
