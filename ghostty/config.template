# Trailing `##` comments are stripped by build-config.sh, which renders this
# template into the config Ghostty actually reads.

# --- Window ---

window-width = 200
window-height = 60
window-padding-x = 12
window-padding-y = 12
macos-titlebar-style = hidden
resize-overlay = never
quit-after-last-window-closed = true

# --- Appearance ---

theme = Catppuccin Macchiato
background-opacity = 0.8
background-opacity-cells = true
background-blur = 80                      ## `true` is only intensity 20, too weak

# --- Font ---

font-family = JetBrainsMono Nerd Font Mono
font-size = 12
font-thicken = true
font-feature = -calt
adjust-cell-width = 1
adjust-cell-height = 1

# --- Cursor ---

cursor-style = block
cursor-style-blink = false
cursor-text = black

# --- Behaviour ---

confirm-close-surface = false
mouse-hide-while-typing = true
macos-option-as-alt = true
shell-integration-features = ssh-terminfo,ssh-env

# --- Keybindings ---

keybind = alt+3=text:#                    ## macos-option-as-alt would otherwise swallow this
keybind = cmd+r=reload_config
keybind = ctrl+shift+q=quit

# Line editing
keybind = alt+left=text:\x1b[1;3D         ## move to previous word
keybind = alt+right=text:\x1b[1;3C        ## move to next word
keybind = cmd+left=text:\x1b[H            ## jump to start of line; the default sends ctrl+a
keybind = cmd+right=text:\x1b[F           ## jump to end of line
